{
  "name": "grab",
  "version": "1.6.7",
  "description": "Grab - video downloader",
  "author": "Or meir Tzarfati",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "test": "node --test",
    "test:media": "cross-env GRAB_REQUIRE_MEDIA_TOOLS=1 node --test tests/media-context.integration.test.cjs",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV=1 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder --win nsis --x64",
    "release": "vite build && electron-builder --win nsis --x64 --publish always",
    "fetch-bin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-bin.ps1",
    "e2e:media-context": "electron e2e/media-context.cjs",
    "e2e:glass-menu": "vite build && electron e2e/glass-menu.cjs",
    "e2e:layout": "vite build && electron e2e/layout.cjs",
    "e2e:liquid-glass": "vite build && electron e2e/liquid-glass.cjs",
    "e2e:screenshots": "vite build && electron e2e/screenshots.cjs",
    "e2e:extension": "node --test --test-timeout=600000 e2e/extension-bridge.cjs",
    "test:package": "node --test tests/browser/packaging.test.cjs",
    "browser:setup": "node scripts/browser-integration.cjs"
  },
  "repository": "github:OrMeirDev/Grab",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.460.0",
    "playwright": "1.58.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "^16.35.0",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.grab.downloader",
    "productName": "Grab",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "extension/lib/**",
      "native-host/*.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": "extension",
        "to": "extension"
      },
      {
        "from": "native-host",
        "to": "native-host"
      },
      "THIRD_PARTY_NOTICES.md"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "OrMeirDev",
        "repo": "Grab",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Grab",
      "installerLanguages": [
        "he_IL"
      ],
      "language": "1037",
      "artifactName": "Grab-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  }
}
