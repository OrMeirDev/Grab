{
  "manifest_version": 3,
  "name": "Grab",
  "short_name": "Grab",
  "version": "1.1.2",
  "description": "\u05de\u05d7\u05d1\u05e8 \u05d0\u05ea \u05d4\u05d3\u05e4\u05d3\u05e4\u05df \u05e9\u05dc\u05da \u05dc-Grab: \u05de\u05d6\u05d4\u05d4 \u05d0\u05ea \u05d4\u05e1\u05e8\u05d8\u05d5\u05df \u05d1\u05e2\u05de\u05d5\u05d3 \u05e9\u05d1\u05d5 \u05d0\u05ea\u05d4 \u05de\u05d7\u05d5\u05d1\u05e8 \u05d5\u05e9\u05d5\u05dc\u05d7 \u05d0\u05d5\u05ea\u05d5 \u05dc\u05d4\u05d5\u05e8\u05d3\u05d4.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "webRequest",
    "webNavigation",
    "tabs",
    "scripting",
    "storage",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Grab",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
